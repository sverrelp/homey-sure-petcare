{
  "name": { "en": "Feeder", "nl": "Voerbak", "no": "Foringsautomat" },
  "class": "petfeeder",
  "platforms": ["local"],
  "connectivity": ["cloud"],
  "capabilities": [
    "measure_food_left",
    "measure_food_right",
    "last_used_by",
    "last_used_at",
    "measure_signal_strength",
    "alarm_offline",
    "measure_battery",
    "alarm_battery"
  ],
  "energy": {
    "batteries": ["C", "C", "C", "C"]
  },
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": { "next": "add_devices" }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ]
}
