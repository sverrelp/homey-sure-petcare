{
  "title": { "en": "Set lock mode for a while", "nl": "Stel vergrendelmodus tijdelijk in", "no": "Sett låsemodus midlertidig" },
  "titleFormatted": {
    "en": "Set lock mode to [[mode]] for [[minutes]] minutes",
    "nl": "Stel vergrendelmodus in op [[mode]] gedurende [[minutes]] minuten",
    "no": "Sett låsemodus til [[mode]] i [[minutes]] minutter"
  },
  "hint": {
    "en": "After this time the door goes back to the mode it had before, unless the mode was changed in the meantime.",
    "nl": "Na deze tijd gaat de deur terug naar de modus die het daarvoor had, tenzij de modus tussentijds is gewijzigd.",
    "no": "Etter dette går døren tilbake til modusen den hadde før, med mindre modusen ble endret i mellomtiden."
  },
  "args": [
    { "type": "device", "name": "door", "filter": "driver_id=flap", "placeholder": { "en": "Door", "nl": "Deur", "no": "Dør" } },
