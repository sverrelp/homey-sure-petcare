        { "id": "normal", "title": { "en": "Normal", "nl": "Normaal", "no": "Normal" }, "label": { "en": "Normal", "nl": "Normaal", "no": "Normal" } },
        { "id": "keep_in", "title": { "en": "Keep in", "nl": "Binnen houden", "no": "Hold inne" }, "label": { "en": "Keep in", "nl": "Binnen houden", "no": "Hold inne" } },
        { "id": "keep_out", "title": { "en": "Keep out", "nl": "Buiten houden", "no": "Hold ute" }, "label": { "en": "Keep out", "nl": "Buiten houden", "no": "Hold ute" } },
        { "id": "locked", "title": { "en": "Locked", "nl": "Vergrendeld", "no": "Låst" }, "label": { "en": "Locked", "nl": "Vergrendeld", "no": "Låst" } },
        { "id": "curfew", "title": { "en": "Curfew", "nl": "Avondklok", "no": "Utegangsforbud" }, "label": { "en": "Curfew", "nl": "Avondklok", "no": "Utegangsforbud" } }
      ] },
    { "type": "number", "name": "minutes", "min": 1, "max": 1440, "step": 1, "placeholder": { "en": "30", "nl": "30", "no": "30" } }
  ]
